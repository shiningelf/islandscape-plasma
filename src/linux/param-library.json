            "shallow": {"min": 120, "max": 700, "step": 1},
            "palms": {"min": 0, "max": 10, "step": 1},
            "kayaks": {"min": 0, "max": 4, "step": 1},
            "birds": {"min": 0, "max": 8, "step": 1}
        },
        "meadow": {
            "sigma": {"min": 40, "max": 200, "step": 1},
            "cover": {"min": 0, "max": 1, "step": 0.01},
            "flow": {"min": 0, "max": 3, "step": 0.05}
        }
    }
}
